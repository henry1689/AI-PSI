# AI-PSI Cognitive Runtime — 环境变量样例
#
# 使用方法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除，禁止提交。
# 所有变量前缀均为 AI_PSI_（见 src/ai_psi/config.py）。

# ---------------------------------------------------------------------------
# 运行时
# ---------------------------------------------------------------------------
AI_PSI_ENV=development
AI_PSI_DEBUG=false
AI_PSI_LOG_LEVEL=INFO
# 结构化日志中是否输出用户正文。默认 false —— 见任务书 §17.1 日志脱敏要求。
AI_PSI_LOG_INCLUDE_USER_CONTENT=false

# ---------------------------------------------------------------------------
# 数据库（对应 docker-compose.yml 的 postgres 服务）
# ---------------------------------------------------------------------------
AI_PSI_DATABASE_URL=postgresql+psycopg://ai_psi:ai_psi_dev_pw@localhost:55432/ai_psi
# 集成测试专用库。留空则由开发库名派生（追加 _test）。
# 🔴 集成测试会 TRUNCATE 数据表，**绝不能**指到开发库——配置层会拒绝两者相同。
AI_PSI_TEST_DATABASE_URL=
POSTGRES_USER=ai_psi
POSTGRES_PASSWORD=ai_psi_dev_pw
POSTGRES_DB=ai_psi
POSTGRES_PORT=55432
# 无法直连 Docker Hub 时改指镜像源，例如：
# AI_PSI_PG_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
AI_PSI_PG_IMAGE=

# ---------------------------------------------------------------------------
# 认知预算（任务书 §13.1、ADR-0008）
# ---------------------------------------------------------------------------
# ⚠️ 预算**按认知深度 D0–D4 分别配置**，权威表在
#   src/ai_psi/domain/cognitive_rounds.py 的 _BUDGET_BY_DEPTH。
# 环境变量形式的按深度覆盖将在后续阶段提供（见 risks.md R16）。
# 反刍判定的重复度阈值可调：
AI_PSI_REPETITION_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# LLM Provider（阶段 4：真实 Provider 已接入，ADR-0003 / ADR-0016）
#
# 可选：mock（默认，零外部依赖）| deepseek | openai_compatible
# ⚠️ Anthropic 本阶段未实现；配置它会在装配时明确报错，而不是静默回落。
# ⚠️ 缺 API Key 时会**明确失败**，绝不静默回落到 Mock——
#    静默回落会让你以为在跟真实模型对话。
# ---------------------------------------------------------------------------
AI_PSI_LLM_PROVIDER=mock
# 留空表示按 Provider 取默认模型（deepseek → deepseek-v4-flash）
AI_PSI_LLM_MODEL=

# 密钥只允许通过环境变量注入，禁止写入代码、配置文件或日志。
# deepseek 同时接受业界通用名 DEEPSEEK_API_KEY（不必再配一份带前缀的）。
AI_PSI_DEEPSEEK_API_KEY=
AI_PSI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_PSI_OPENAI_API_KEY=
AI_PSI_OPENAI_BASE_URL=

# 是否启用供应商的 JSON 输出模式。不支持 response_format 的兼容服务器请置 false。
AI_PSI_LLM_JSON_MODE=true

# 给推理模型的额外输出预留（token）。推理 token 也计入 max_tokens，
# 不留足预留会让答案被推理挤掉后截断。留空 = 用 Provider 的默认值。
# ⚠️ 它是"上限"不是"花费"：没生成到那么多就不会计费，但设小了会截断。
AI_PSI_LLM_REASONING_HEADROOM_TOKENS=

# 熔断：连续多少次"供应商不可用"类失败后打开，以及冷却秒数。
AI_PSI_LLM_CIRCUIT_FAILURE_THRESHOLD=5
AI_PSI_LLM_CIRCUIT_RECOVERY_SECONDS=30

# 真实模型端到端测试（会花钱、会联网）。默认跳过。
# 需要同时配置上面的 API Key 与这个开关：make test-live
AI_PSI_RUN_LIVE_TESTS=0
AI_PSI_LLM_TIMEOUT_SECONDS=60
AI_PSI_LLM_MAX_RETRIES=2
AI_PSI_LLM_MODEL=
AI_PSI_ANTHROPIC_API_KEY=
AI_PSI_OPENAI_API_KEY=
AI_PSI_OPENAI_BASE_URL=