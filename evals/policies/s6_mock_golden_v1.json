    "expected_assertion_count": 65,
    "metrics_definition_digest": "sha256:be4bcdd8fb016529db2cb411a514670b6a88ebb8f2af0dd925b102d89ce43905",
    "metrics_schema_version": 1,
    "migration_revision": null,
    "model": "mock-model-v1",
